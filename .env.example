# ============================================================
# novix-open — one file to configure. Copy to .env and edit.
# ============================================================

# ---------- server ----------
PORT_SITE=8081
# JWT signing secret (change this in any shared deployment)
NOVIX_JWT_SECRET=change-me-novix-open
# Where sessions, workspaces and uploads live
NOVIX_DATA_DIR=./data
# Code execution sandbox: auto | docker | local
SANDBOX=auto
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_MS=120000
PYTHON_BIN=python3

# ---------- LLM (required for real output) ----------
# Option A: one OpenAI-compatible endpoint (covers OpenAI / vLLM / Ollama / LiteLLM / Together / DeepSeek ...)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Option B: per-gateway keys. The UI passes `<gateway>__<model-id>`; unconfigured
# gateways silently fall back to LLM_API_BASE.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LITELLM_API_BASE=
LITELLM_API_KEY=
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_API_KEY=
ZAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZAI_API_KEY=
PROXY_API_BASE=
PROXY_API_KEY=
PROXY_MODEL=gpt-4o-mini

# ---------- literature (optional, all keyless) ----------
# arXiv and Crossref need nothing. Semantic Scholar works better with a key.
SEMANTIC_SCHOLAR_API_KEY=

# ---------- CORS / public origin ----------
PUBLIC_ORIGIN=http://127.0.0.1:8081
