{
  "$comment": "HTTP contract. Base path /api. Success envelope: {\"code\":\"0\",\"message\":\"Success\",\"result\":...}. Auth: Authorization: Bearer <opaque 44-byte server session token> (NOT a JWT); anonymous via fingerprint header. Verified 2026-10-09 against live novix.science + bundle index-Dk9cCEgm.js.",
  "version": "3",
  "base": "/api",
  "sse": {
    "path": "/api/chat/",
    "method": "GET",
    "query": ["token", "query", "chatSessionId", "chatStatus"],
    "headers": ["Authorization: Bearer <token>", "Accept: text/event-stream"],
    "framing": "space-padded lines; event:complete sentinel",
    "events": [
      { "name": "message", "data": "text delta (raw string)" },
      { "name": "response", "data": "{\"messages\":[{\"role\":\"...\",\"content\":\"...\"}]}" },
      { "name": "complete", "data": "(empty)" }
    ],
    "chatStatus": ["init", "continue"],
    "note": "Client parses with fetch+reader (not EventSource). Token in query string is a known upstream leak; this implementation accepts header only and treats query token as deprecated. Observed live in the bundle at :163356/:163683; believed to serve Discuss mode."
  },
  "endpoints": [
    { "path": "/user/login", "method": "POST", "auth": false, "params": "query", "desc": "email+password" },
    { "path": "/user/emailSignUp", "method": "POST", "auth": false, "params": "query" },
    { "path": "/user/sendEmailAuthCode", "method": "GET", "auth": false, "params": "query" },
    { "path": "/user/resetPassword", "method": "POST", "auth": false, "params": "query" },
    { "path": "/user/getUserInfo", "method": "POST", "auth": true, "params": "query" },
    { "path": "/user/getUserCreditInfo", "method": "POST", "auth": true, "params": "query" },
    { "path": "/user/getUserCreditUsage", "method": "POST", "auth": true, "params": "query" },
    { "path": "/user/getAvailableCoupons", "method": "GET", "auth": true, "params": "query", "suspect": "not seen in live bundle" },
    { "path": "/user/workspace/init", "method": "POST", "auth": true, "params": "query" },
    { "path": "/user/workspace/interest", "method": "GET", "auth": true, "params": "query" },
    { "path": "/user/feature_white_list/enabled", "method": "GET", "auth": true, "params": "query", "note": "feature gate, e.g. auto_discovery_manual_switch" },
    { "path": "/site-config/public", "method": "GET", "auth": false, "params": "-" },

    { "path": "/account/info", "method": "GET", "auth": true, "added": true },
    { "path": "/account/upgrade", "method": "POST", "auth": true, "added": true },

    { "path": "/chat_session/create", "method": "POST", "auth": true },
    { "path": "/chat_session/create_anonymous", "method": "POST", "auth": false, "body": "{}" },
    { "path": "/chat_session/list", "method": "GET", "auth": true },
    { "path": "/chat_session/active", "method": "GET", "auth": true },
    { "path": "/chat_session/message/list", "method": "GET", "auth": "share-or-token" },
    { "path": "/chat_session/status", "method": "GET", "auth": true },
    { "path": "/chat_session/share", "method": "POST", "auth": true, "body": "{\"chatSessionId\"}" },
    { "path": "/chat_session/bind_anonymous", "method": "POST", "auth": true },
    { "path": "/chat_session/rename", "method": "POST", "auth": true },
    { "path": "/chat_session/delete", "method": "POST", "auth": true },
    { "path": "/chat_session/workspace", "method": "GET", "auth": true },
    { "path": "/chat_session/workspace/subtree", "method": "POST", "auth": true, "body": "{\"chatSessionId\",\"path\":\".\"}" },
    { "path": "/chat_session/workspace/download_workspace_url", "method": "GET", "auth": true },
    { "path": "/chat_session/workspace/home_files", "method": "GET", "auth": true },
    { "path": "/chat_session/workspace/home_file_preview", "method": "POST", "auth": true },
    { "path": "/chat_session/workspace/user_upload/delete", "method": "POST", "auth": true },
    { "path": "/chat_session/workspace/user_workspace/subtree", "method": "POST", "auth": true },

    { "path": "/home/novix/workspace", "method": "POST", "auth": true, "added": true },

    { "path": "/task/create_task", "method": "POST", "auth": true },
    { "path": "/task/create_anonymous_task", "method": "POST", "auth": false, "body": "JSON (query string -> 4000)" },
    { "path": "/task/create_internal_task_with_signature", "method": "POST", "auth": true, "added": true },
    { "path": "/task/get_task", "method": "GET", "auth": "share-or-token", "query": ["taskId"] },
    { "path": "/task/submit_user_question", "method": "POST", "auth": true },
    { "path": "/call_agent", "method": "POST", "auth": true, "suspect": "not seen in live bundle" },
    { "path": "/agents", "method": "GET", "auth": true, "suspect": "not seen in live bundle" },

    { "path": "/file/batch_temp_urls", "method": "POST", "auth": true },
    { "path": "/file/upload_stream", "method": "POST", "auth": true, "body": "multipart, field 'file'" },
    { "path": "/file/upload_complete", "method": "POST", "auth": true },
    { "path": "/file/temp_url", "method": "GET", "auth": true },
    { "path": "/file/download", "method": "GET", "auth": "share-or-token", "query": ["fileKey"] },

    { "path": "/oss/getSTSToken", "method": "GET", "auth": true, "added": true },

    { "path": "/published/item/publish", "method": "POST", "auth": true },
    { "path": "/published/item/publish/access", "method": "GET", "auth": true, "returns": "{canPublish, message}" },
    { "path": "/published/revision/{revisionId}/session", "method": "GET", "auth": false },
    { "path": "/published/revision/{revisionId}/task", "method": "GET", "auth": false, "query": ["taskId"] },
    { "path": "/published/revision/{revisionId}/workspace/subtree", "method": "POST", "auth": false, "body": "{targets}" },
    { "path": "/published/revision/{revisionId}/fork", "method": "POST", "auth": true, "added": true, "returns": "new sessionId" },

    { "path": "/search", "method": "POST", "auth": "shared-token", "body": "{\"query\",\"request_id\",\"topK\"}", "suspect": "not seen in live bundle" },
    { "path": "/get_searchHistory", "method": "GET", "auth": true },
    { "path": "/referral/me", "method": "GET", "auth": true, "suspect": "not seen in live bundle" },
    { "path": "/likeTask", "method": "POST", "auth": true },
    { "path": "/getTaskFeedback", "method": "GET", "auth": true },
    { "path": "/credit/upgrade_plan", "method": "POST", "auth": true },
    { "path": "/credit/subscription/upgrade", "method": "POST", "auth": true },
    { "path": "/credit/list", "method": "GET", "auth": true, "added": true },
    { "path": "/credit/billing-statements", "method": "GET", "auth": true, "added": true },
    { "path": "/credit/cancel", "method": "POST", "auth": true, "added": true },
    { "path": "/credit/invite", "method": "POST", "auth": true, "added": true },
    { "path": "/credit/one-time-plans", "method": "GET", "auth": true, "added": true },
    { "path": "/credit/join", "method": "POST", "auth": true, "query": ["inviteId"] },
    { "path": "/credit/remove", "method": "POST", "auth": true },
    { "path": "/notification/list", "method": "GET", "auth": true },
    { "path": "/notification/latest", "method": "GET", "auth": true, "added": true },
    { "path": "/notification/version-history", "method": "GET", "auth": false },
    { "path": "/auto_ideaspark/ideas", "method": "GET", "auth": true },
    { "path": "/auto_ideaspark/modify", "method": "POST", "auth": true },
    { "path": "/gallery/list", "method": "GET", "auth": false, "suspect": "not seen in live bundle" },
    { "path": "/models", "method": "GET", "auth": false, "suspect": "not seen in live bundle" }
  ],
  "publish": {
    "base": "https://pub.novix.science",
    "urlFormat": "<base>/{publishedItemId}/v{revisionNo}/"
  },
  "taskCreateBody": {
    "agentName": "string (AgentNameEnum or \"\")",
    "query": "agent.value + ' ' + raw query",
    "queryContent": "hiddenPrompt + '\\n\\n' + query",
    "enableGpu": "boolean (forced false when fileIds present)",
    "enableBrainstorming": "boolean",
    "questionMode": "enableBrainstorming ? 'discuss' : 'task'",
    "modelOverride": "selectedModel, or DISCUSS_MODE_MODEL_OVERRIDE (= DEFAULT_MODEL_OPTION_VALUE = 'novix_proxy__gpt-6.1-sol') when brainstorming",
    "writeUpType": "paper|report|ppt (only Deep Search Agent / Proposal Agent)",
    "tempUrl": "string|null",
    "fileIds": "string[]",
    "chatSessionId": "string"
  },
  "taskPoll": { "initialMs": 500, "intervalMs": 2000, "statuses": ["init", "processing", "finish", "error"], "terminal": ["finish", "error"] },
  "constants": {
    "SUPPORTED_EXTENSIONS": ["pdf", "doc", "docx", "txt", "md", "rtf", "xls", "xlsx", "csv", "tsv", "ppt", "pptx", "jpg", "jpeg", "png", "gif", "bmp", "zip", "rar", "7z", "tar", "gz", "bz2", "xz", "tgz", "html", "xml", "json", "py", "ipynb", "parquet"],
    "MAX_FILE_COUNT": 100,
    "MAX_SINGLE_FILE_SIZE_MB": 100,
    "MAX_CONCURRENT_UPLOADS": 5,
    "PENDING_SESSION_LAUNCH_STORAGE_KEY": "nova-fed:pending-session-launch",
    "PUBLISH_DONT_SHOW_KEY": "novix.publish.dontShowIntro",
    "contactEmail": "yasmine_li@novix.science",
    "discordInvite": "https://discord.com/invite/J6ws3Pj49k"
  }
}
